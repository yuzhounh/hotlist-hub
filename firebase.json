{
  "hosting": {
    "public": "dist_netlify",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "_headers"
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

